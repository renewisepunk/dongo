{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dongo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "dev.dongo.so/p/*", "zone_name": "dongo.so" },
    { "pattern": "dev.dongo.so/.well-known/oauth-protected-resource/*", "zone_name": "dongo.so" }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://dev.dongo.so",
    "ALLOWED_HOSTNAMES": "dev.dongo.so",
    "ALLOWED_ORIGIN_HOSTNAMES": "dev.dongo.so",
    "AUTHORIZATION_SERVER_ISSUER": "https://dev.dongo.so/api/auth",
    "BETTER_AUTH_INTROSPECTION_URL": "https://dev.dongo.so/api/auth/oauth2/introspect",
    "BETTER_AUTH_RESOURCE_CLIENT_ID": "dongo-mcp-resource-dev",
    "CONVEX_SITE_URL": "https://wandering-camel-662.convex.site"
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
