{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dongo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "dev.dongo.so/api/mcp/*", "zone_name": "dongo.so" },
    { "pattern": "dev.dongo.so/p/*", "zone_name": "dongo.so" },
    { "pattern": "dev.dongo.so/.well-known/oauth-protected-resource/*", "zone_name": "dongo.so" }
  ],
  "services": [
    { "binding": "AUTH_SERVICE", "service": "dongo-auth-dev" }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://dev.dongo.so",
    "ALLOWED_HOSTNAMES": "dev.dongo.so",
    "ALLOWED_ORIGIN_HOSTNAMES": "dev.dongo.so",
    "AUTHORIZATION_SERVER_ISSUER": "https://dev.dongo.so/api/auth",
    "AUTHORIZATION_SERVER_METADATA_JSON": "{\"client_id_metadata_document_supported\":true,\"scopes_supported\":[\"dongo:work:read\",\"dongo:work:write\",\"dongo:attachments:read\",\"offline_access\"],\"issuer\":\"https://dev.dongo.so/api/auth\",\"authorization_endpoint\":\"https://dev.dongo.so/api/auth/oauth2/authorize\",\"token_endpoint\":\"https://dev.dongo.so/api/auth/oauth2/token\",\"registration_endpoint\":\"https://dev.dongo.so/api/auth/oauth2/register\",\"introspection_endpoint\":\"https://dev.dongo.so/api/auth/oauth2/introspect\",\"revocation_endpoint\":\"https://dev.dongo.so/api/auth/oauth2/revoke\",\"response_types_supported\":[\"code\"],\"grant_types_supported\":[\"authorization_code\",\"refresh_token\",\"urn:ietf:params:oauth:grant-type:device_code\"],\"code_challenge_methods_supported\":[\"S256\"],\"device_authorization_endpoint\":\"https://dev.dongo.so/api/auth/device/code\"}",
    "BETTER_AUTH_INTROSPECTION_URL": "https://dev.dongo.so/api/auth/oauth2/introspect",
    "BETTER_AUTH_RESOURCE_CLIENT_ID": "dongo-mcp-resource-dev",
    "CONVEX_SITE_URL": "https://wandering-camel-662.convex.site",
    "SERVICE_DOCUMENTATION_URL": "https://dev.dongo.so/help"
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "env": {
    "production": {
      "name": "dongo-mcp-production",
      "workers_dev": false,
      "routes": [
        { "pattern": "dongo.so/api/mcp/*", "zone_name": "dongo.so" },
        { "pattern": "dongo.so/p/*", "zone_name": "dongo.so" },
        { "pattern": "dongo.so/.well-known/oauth-protected-resource/*", "zone_name": "dongo.so" }
      ],
      "services": [
        { "binding": "AUTH_SERVICE", "service": "dongo-auth-production" }
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://dongo.so",
        "ALLOWED_HOSTNAMES": "dongo.so",
        "ALLOWED_ORIGIN_HOSTNAMES": "dongo.so",
        "AUTHORIZATION_SERVER_ISSUER": "https://dongo.so/api/auth",
        "AUTHORIZATION_SERVER_METADATA_JSON": "{\"client_id_metadata_document_supported\":true,\"scopes_supported\":[\"dongo:work:read\",\"dongo:work:write\",\"dongo:attachments:read\",\"offline_access\"],\"issuer\":\"https://dongo.so/api/auth\",\"authorization_endpoint\":\"https://dongo.so/api/auth/oauth2/authorize\",\"token_endpoint\":\"https://dongo.so/api/auth/oauth2/token\",\"registration_endpoint\":\"https://dongo.so/api/auth/oauth2/register\",\"introspection_endpoint\":\"https://dongo.so/api/auth/oauth2/introspect\",\"revocation_endpoint\":\"https://dongo.so/api/auth/oauth2/revoke\",\"response_types_supported\":[\"code\"],\"grant_types_supported\":[\"authorization_code\",\"refresh_token\",\"urn:ietf:params:oauth:grant-type:device_code\"],\"code_challenge_methods_supported\":[\"S256\"],\"device_authorization_endpoint\":\"https://dongo.so/api/auth/device/code\"}",
        "BETTER_AUTH_INTROSPECTION_URL": "https://dongo.so/api/auth/oauth2/introspect",
        "BETTER_AUTH_RESOURCE_CLIENT_ID": "dongo-mcp-resource-production",
        "CONVEX_SITE_URL": "https://brainy-camel-172.convex.site",
        "SERVICE_DOCUMENTATION_URL": "https://dongo.so/help"
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_RESOURCE_CLIENT_SECRET",
          "DONGO_INTERNAL_GATEWAY_SECRET"
        ]
      },
      "ratelimits": [
        {
          "name": "MCP_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": {
            "limit": 120,
            "period": 60
          }
        }
      ]
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
