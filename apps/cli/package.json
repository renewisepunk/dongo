{
  "name": "@wisepunk/dongo",
  "version": "0.2.14",
  "description": "Agent-first project management from the terminal and MCP hosts.",
  "type": "module",
  "homepage": "https://dongo.so/get-started",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renewisepunk/dongo.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/renewisepunk/dongo/issues"
  },
  "keywords": [
    "dongo",
    "mcp",
    "agents",
    "project-management"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dongo": "dist/dongo.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@dongo/cli-core": "0.1.0",
    "@dongo/client": "0.1.0",
    "@dongo/contracts": "0.1.0",
    "esbuild": "0.28.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  }
}
