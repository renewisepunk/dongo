{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../../packages/client/src/**/*.ts",
    "../../packages/cli-core/src/**/*.ts",
    "../../packages/repo-export/src/**/*.ts"
  ]
}
