{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dongo-files-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "dev.dongo.so/api/files/*", "zone_name": "dongo.so" }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "dongo-dev-attachments"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://dev.dongo.so",
    "ALLOWED_BROWSER_ORIGIN": "https://dev.dongo.so",
    "CONVEX_SITE_URL": "https://wandering-camel-662.convex.site"
  },
  "ratelimits": [
    {
      "name": "FILES_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ],
  "env": {
    "production": {
      "name": "dongo-files-production",
      "routes": [
        { "pattern": "dongo.so/api/files/*", "zone_name": "dongo.so" }
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "dongo-attachments"
        }
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://dongo.so",
        "ALLOWED_BROWSER_ORIGIN": "https://dongo.so",
        "CONVEX_SITE_URL": "https://brainy-camel-172.convex.site"
      },
      "secrets": {
        "required": [
          "DONGO_ATTACHMENT_URL_SIGNING_SECRET",
          "DONGO_INTERNAL_GATEWAY_SECRET"
        ]
      },
      "ratelimits": [
        {
          "name": "FILES_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": {
            "limit": 180,
            "period": 60
          }
        }
      ]
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
