{
  "name": "@dongo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "dev": "vite dev",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium firefox webkit",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@convex-dev/better-auth": "0.12.5",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "1.0.0",
    "@solidjs/start": "2.0.4",
    "better-auth": "1.6.30",
    "convex": "1.45.0",
    "marked": "^18.0.11",
    "solid-js": "1.9.15",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "typescript": "7.0.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
