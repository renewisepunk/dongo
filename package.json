{
  "name": "dongo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @dongo/web",
    "check": "npm run check:landing && npm run check:workspaces && npm run typecheck:workspaces && npm run check:convex",
    "check:landing": "tsc --noEmit && wrangler deploy --dry-run",
    "check:workspaces": "npm run check --workspaces --if-present",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "check:convex": "tsc -p convex/tsconfig.json --noEmit",
    "deploy": "npm run deploy:landing",
    "deploy:dev": "npm run deploy --workspace @dongo/web",
    "deploy:landing": "wrangler deploy",
    "dev": "npm run dev --workspace @dongo/web",
    "dev:landing": "wrangler dev",
    "generate:contracts": "node scripts/generate-contract-artifacts.mjs",
    "test": "npm run test:workspaces && npm run test:convex",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:convex": "vitest run convex/testing",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "verify:environment-boundaries": "node scripts/verify-environment-boundaries.mjs",
    "verify:contracts": "node scripts/generate-contract-artifacts.mjs --check",
    "verify:no-secrets": "node scripts/verify-no-secrets.mjs",
    "verify:runtime-logs": "node scripts/verify-runtime-logs.mjs",
    "types": "wrangler types",
    "convex:codegen": "convex codegen",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "better-auth": "1.6.30",
    "convex": "1.45.0",
    "react": "19.2.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "convex-test": "0.0.56",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
