{
  "name": "dongo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @dongo/web",
    "check": "npm run build:check-dependencies && npm run verify:brand-case && npm run check:landing && npm run check:workspaces && npm run typecheck:workspaces && npm run check:convex",
    "build:check-dependencies": "npm run build --workspace @dongo/mcp",
    "check:landing": "tsc --noEmit && wrangler deploy --dry-run",
    "check:workspaces": "npm run check --workspaces --if-present",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "check:convex": "tsc -p convex/tsconfig.json --noEmit",
    "deploy": "npm run deploy:production",
    "deploy:dev": "node scripts/deploy-dev.mjs",
    "deploy:dev:plan": "node scripts/deploy-dev.mjs --plan",
    "deploy:dev:web": "npm run deploy --workspace @dongo/web",
    "deploy:production": "node scripts/deploy-production.mjs",
    "deploy:production:plan": "node scripts/deploy-production.mjs --plan",
    "deploy:production:web": "node scripts/deploy-production-web.mjs",
    "prepare:production": "node scripts/prepare-production.mjs",
    "deploy:landing": "wrangler deploy",
    "dev": "npm run dev --workspace @dongo/web",
    "dev:landing": "wrangler dev",
    "generate:contracts": "node scripts/generate-contract-artifacts.mjs",
    "test": "npm run test:workspaces && npm run test:convex && npm run test:release-process",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:convex": "vitest run convex/testing",
    "test:release-process": "node --test scripts/*.test.mjs",
    "release:cli": "node scripts/release-cli.mjs --publish",
    "release:cli:plan": "node scripts/release-cli.mjs --plan",
    "smoke:boundaries": "node scripts/smoke-boundaries.mjs",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "verify:environment-boundaries": "node scripts/verify-environment-boundaries.mjs",
    "verify:observability": "node scripts/verify-observability.mjs",
    "verify:contracts": "node scripts/generate-contract-artifacts.mjs --check",
    "verify:work-completion": "node scripts/verify-work-completion.mjs",
    "verify:brand-case": "node scripts/verify-brand-case.mjs",
    "verify:cli-package": "node scripts/verify-cli-package.mjs",
    "verify:no-secrets": "node scripts/verify-no-secrets.mjs",
    "verify:runtime-logs": "node scripts/verify-runtime-logs.mjs",
    "verify:agent-release-notice": "node scripts/verify-agent-release-notice.mjs",
    "activate:agent-release-notice": "node scripts/activate-agent-release-notice.mjs",
    "types": "wrangler types",
    "convex:codegen": "convex codegen",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "better-auth": "1.6.30",
    "convex": "1.45.0",
    "react": "19.2.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@types/node": "^26.4.0",
    "convex-test": "0.0.56",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
